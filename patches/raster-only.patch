+int
+konica_raster_only(const konica_cfg_t *cfg)
+{
+  return cfg->raster_only;
+}
+
+/* PAPPL only puts d->format into document-format-supported.  Declaring no
+ * printer-specific format ("application/octet-stream" is always present)
+ * leaves PWG/URF/JPEG/PNG and removes application/pdf.  The string must stay
+ * non-NULL: PAPPL compares job formats against it with strcmp(). */
+const char *
+konica_document_format(const konica_cfg_t *cfg)
+{
+  return cfg->raster_only ? "application/octet-stream" : "application/pdf";
+}
