diff --git a/test/test_raster_only.c b/test/test_raster_only.c
new file mode 100644
index 0000000..a92237a
--- /dev/null
+++ b/test/test_raster_only.c
@@ -0,0 +1,56 @@
+/*
+ * Raster-only regression test for konica206-native.
+ *
+ * Includes konica_filter.c directly (the same trick as test_ppd.c) so this
+ * runs as a normal user with no PAPPL server, no printer, no USB device, no
+ * CUPS queue, no Ghostscript and no proprietary vendor data.
+ */
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "konica_filter.c"
+
+static int failures = 0;
+
+static void
+check(int ok, const char *what)
+{
+  printf("%s: %s\n", ok ? "ok" : "FAIL", what);
+  if (!ok)
+    failures ++;
+}
+
+int
+main(void)
+{
+  konica_cfg_t cfg;
+
+  unsetenv("KONICA_RASTER_ONLY");
+  konica_cfg_load(&cfg);
+  check(!konica_raster_only(&cfg), "default mode accepts PDF");
+  check(!strcmp(konica_document_format(&cfg), "application/pdf"),
+        "default document format is application/pdf");
+
+  setenv("KONICA_RASTER_ONLY", "1", 1);
+  konica_cfg_load(&cfg);
+  check(konica_raster_only(&cfg), "KONICA_RASTER_ONLY=1 is parsed");
+  check(strcmp(konica_document_format(&cfg), "application/pdf") != 0,
+        "raster-only mode does not advertise application/pdf");
+  check(!strcmp(konica_document_format(&cfg), "application/octet-stream"),
+        "raster-only mode leaves only the built-in raster formats");
+
+  setenv("KONICA_RASTER_ONLY", "0", 1);
+  konica_cfg_load(&cfg);
+  check(!konica_raster_only(&cfg), "KONICA_RASTER_ONLY=0 keeps PDF enabled");
+  check(!strcmp(konica_document_format(&cfg), "application/pdf"),
+        "PDF format is restored when raster-only is disabled");
+
+  if (failures)
+  {
+    fprintf(stderr, "%d raster-only check(s) failed\n", failures);
+    return 1;
+  }
+  puts("raster-only: all checks passed");
+  return 0;
+}
