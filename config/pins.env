# Pinned inputs for the frozen bizhub 206 IPP Everywhere server.
# Sourced by POSIX shell scripts; keep this the single source of truth.
# Do NOT change a pin without updating docs/upstream-pins.md and re-running
# the raster-only and physical acceptance gates.

ALPINE_VERSION=3.24.2
ALPINE_ARCH=x86_64
ALPINE_MINIROOTFS_SHA256=c5ca053cfe1d85c5b96dff8b9bc57045f7f184a30ffb6b65776409ca90388677
ALPINE_BASEURL=https://dl-cdn.alpinelinux.org/alpine

PAPPL_VERSION=1.3.1
PAPPL_COMMIT=8eb465be78469c1344e7305bf02d305ee7907e36
KONICA206_NATIVE_ALPINE_COMMIT=e2855dd2ad3ec77cb35ec717b68bb26a2f94ec0d
KONICA_NATIVE_MUSL_COMMIT=e1d522ed8c655541469b6aa49c5ecdec76b7b9d6

# Local patch applied to the pinned application before it is built.
RASTER_ONLY_PATCH=patches/raster-only.patch

# Name of the frozen tarball produced by Phase 1 (and consumed by Phase 2).
FROZEN_ARCHIVE=konica206-frozen-2026-11.tar.zst

MACHINE_NAME=konica-frozen
IPP_PORT=${IPP_PORT:-8001}
ROOTFS=${ROOTFS:-/var/lib/machines/konica-frozen}
STATE_DIR=${STATE_DIR:-/var/lib/konica206-frozen}
CACHE_DIR=${CACHE_DIR:-/var/cache/konica206-frozen}

# Device facts (verify on the target machine).
PRINTER_USB_ID=132b:232b
PRINTER_SERIAL=A8A6041029423
